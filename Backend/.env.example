# ==============================================================
# Backend/.env.example — คัดลอกเป็น Backend/.env แล้วใส่ค่าจริง
# ห้าม commit ไฟล์ .env ตัวจริงเข้า git (มี .env ใน .gitignore แล้ว)
# ==============================================================

# --- Database: TiDB Cloud (หรือ MySQL อื่นที่ compatible) ---
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=chatbot

# --- JWT ---
# สร้างค่าใหม่ด้วยคำสั่ง: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ห้ามใช้ค่าเดียวกันระหว่าง dev/test/production
JWT_SECRET_KEY=

# --- Initial Admin Bootstrap (ใช้ตอน DB ว่างครั้งแรกเท่านั้น) ---
# ถ้าเว้นว่าง ระบบจะสุ่มรหัสผ่านให้อัตโนมัติและ print ออก console ตอน startup ครั้งแรก
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- LLM ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
