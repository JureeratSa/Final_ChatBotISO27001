# Dependency directories
node_modules/
node-v20.12.2-win-x64/

# Build outputs
dist/
build/

# Local databases and runtime data
user/backend/db/*.json
!user/backend/db/db_settings.json  # Keep default setting schema but ignore active runtime data changes

# Uploaded documents
uploads/
*.pdf

# Vector database index files (ChromaDB/BM25 output)
index_db/
index_db_backup/

# Local SQLite files (เช่น sqlite ที่สร้างเองตอนทดสอบ Alembic migration ด้วยมือ)
*.db
*.db-journal

# Environments and credentials
.env
.env.local
.env.*.local

# Python caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Log files
*.log

# Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# testchatbotSPO: เก็บสคริปต์วัดผล + ชุดคำถาม แต่ไม่เก็บ cache ของ LLM judge และไฟล์ผลลัพธ์ที่สร้างใหม่ทุกครั้งที่รัน
testchatbotSPO/*_cache.json
testchatbotSPO/*.xlsx
!testchatbotSPO/questions_dataset.xlsx
