# ==============================================================
# Backend/.env.example — คัดลอกเป็น Backend/.env แล้วใส่ค่าจริง
# ห้าม commit ไฟล์ .env ตัวจริงเข้า git (มี .env ใน .gitignore แล้ว)
# ==============================================================

# --- Database: Microsoft SQL Server (ดู docs/SQLSERVER_MIGRATION.md) ---
DB_ENGINE=mssql
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
# true เฉพาะเมื่อใบรับรองของ SQL Server ออกเอง (self-signed) — ถ้าได้ไฟล์ CA จาก IT ควรติดตั้ง CA แทน
DB_TRUST_SERVER_CERTIFICATE=false

# --- (ย้อนกลับไป TiDB Cloud เท่านั้น) ---
# DB_ENGINE=mysql
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=chatbot

# --- JWT ---
# สร้างค่าใหม่ด้วยคำสั่ง: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ห้ามใช้ค่าเดียวกันระหว่าง dev/test/production
JWT_SECRET_KEY=

# --- Initial Admin Bootstrap (ใช้ตอน DB ว่างครั้งแรกเท่านั้น) ---
# ถ้าเว้นว่าง ระบบจะสุ่มรหัสผ่านให้อัตโนมัติและ print ออก console ตอน startup ครั้งแรก
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# --- CORS ---
FRONTEND_URL=http://localhost:5173
# ชื่อเครื่องเซิร์ฟเวอร์ที่ผู้ใช้ใช้เปิดเว็บแทน IP (คั่นด้วย ,) — ไม่ตั้ง = เปิดได้แค่ด้วย IP วง 172.30.x.x / localhost
# ตัวอย่าง: CORS_EXTRA_HOSTS=chatbot-server,chatbot-server.hospital.local
CORS_EXTRA_HOSTS=

# --- LLM (GDCC LiteLLM endpoint, รูปแบบ OpenAI) ---
# LITELLM_URL = base URL ที่ลงท้ายด้วย /v1  ชื่อโมเดลตั้งที่ DEFAULT_LLM_MODEL ใน app/core/config.py
LITELLM_URL=
LITELLM_API_KEY=
# ของเดิม (OpenRouter) เลิกใช้แล้ว:
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# --- OCR สำหรับ PDF สแกน: Typhoon OCR 1.5 บน GDCC (รูปแบบ OpenAI, URL ลงท้ายด้วย /v1) ---
# ใช้ตอนอัปโหลด/rebuild เฉพาะหน้าที่เป็นภาพสแกน (ดู Admin/pdf_ocr.py) เว้นว่าง = ไม่ OCR หน้าสแกนจะไม่มีข้อความ
# ชื่อโมเดลต้องตรงกับ GET <URL>/models (บน GDCC คือ typhoon-ocr-1-5)
TYPHOON_OCR_URL=
TYPHOON_OCR_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr-1-5
# Tesseract หาตำแหน่งคำบนหน้าสแกน เพื่อไฮไลท์อ้างอิง (Typhoon ไม่ให้ตำแหน่งคำ)
# ติดตั้ง: winget install UB-Mannheim.TesseractOCR แล้ววาง tha.traineddata (github.com/tesseract-ocr/tessdata_best)
# ในโฟลเดอร์ tessdata ของ Tesseract — เว้นว่าง = หาใน PATH, ไม่มี = หน้าสแกนเปิดได้แต่ไม่มีไฮไลท์
TESSERACT_CMD=

# ─── Vector Index ───
# ที่เก็บ ChromaDB ต้องเป็นชุดเดียวกับ index_db/bm25.pkl (สร้างจาก rebuild ครั้งเดียวกัน)
# เว้นว่าง = <repo>/index_db/chroma_db  แนะนำให้อยู่บนดิสก์ในเครื่อง ไม่ใช่ network drive
CHROMA_DB_DIR=
