# build context ที่ root ใช้กับเว็บ (infra/docker/web.Dockerfile) เท่านั้น — backend ใช้ services/api/.dockerignore
# ห้ามมี secret ในอิมเมจ
**/.env
**/.env.*
!**/.env.example
*.crt
*.key
*.bundle

# เว็บใช้แค่ apps/<ชื่อเว็บ> กับ infra/docker/nginx.conf
services/
uploads/
index_db/
docs/
.git/
.claude/
.agents/
.github/
**/node_modules/
**/dist/
**/__pycache__/
**/*.log
